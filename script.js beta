
const input = document.getElementById("todoInput");
const addBtn = document.getElementById("addBtn");
const todoList = document.getElementById("todoList");

let todos = JSON.parse(localStorage.getItem("todos")) || [];

function displayTodos() {
    todoList.innerHTML = "";

    function getPositions() {
        const positions = new Map();

        todoList.querySelectorAll("li:not(.dragging):not(.drag-placeholder)")
            .forEach(function(item) {
                positions.set(
                    item,
                    item.getBoundingClientRect().top
                );
            });

        return positions;
    }

    function animateMovement(oldPositions) {
        todoList.querySelectorAll("li:not(.dragging):not(.drag-placeholder)")
            .forEach(function(item) {
                const oldTop = oldPositions.get(item);

                if (oldTop === undefined) {
                    return;
                }

                const newTop = item.getBoundingClientRect().top;
                const distance = oldTop - newTop;

                if (distance === 0) {
                    return;
                }

                item.style.transition = "none";
                item.style.transform =
                    "translateY(" + distance + "px)";

                item.getBoundingClientRect();

                requestAnimationFrame(function() {
                    item.style.transition = "";
                    item.style.transform = "";
                });
            });
    }

    todos.forEach(function(todo, index) {
        const li = document.createElement("li");

        li.dataset.index = index;

        li.innerHTML = `
            <span></span>
            <button class="delete-btn">삭제</button>
        `;

        li.querySelector("span").textContent = todo;

        const deleteBtn = li.querySelector(".delete-btn");

        deleteBtn.addEventListener("click", function() {
            todos.splice(index, 1);
            saveTodos();
            displayTodos();
        });

        li.addEventListener("mousedown", function(event) {
            if (event.button !== 0) {
                return;
            }

            if (event.target.closest(".delete-btn")) {
                return;
            }

            const rect = li.getBoundingClientRect();

            const offsetX = event.clientX - rect.left;
            const offsetY = event.clientY - rect.top;

            const placeholder = document.createElement("li");

            placeholder.classList.add("drag-placeholder");
            placeholder.style.height = rect.height + "px";

            todoList.insertBefore(placeholder, li.nextSibling);

            li.classList.add("dragging");

            li.style.width = rect.width + "px";
            li.style.height = rect.height + "px";

            li.style.left = rect.left + "px";
            li.style.top = rect.top + "px";

            function move(moveEvent) {
                li.style.left =
                    (moveEvent.clientX - offsetX) + "px";

                li.style.top =
                    (moveEvent.clientY - offsetY) + "px";

                const target = document.elementFromPoint(
                    moveEvent.clientX,
                    moveEvent.clientY
                );

                const targetLi = target
                    ? target.closest("#todoList > li")
                    : null;

                if (
                    !targetLi ||
                    targetLi === li ||
                    targetLi === placeholder
                ) {
                    return;
                }

                const oldPositions = getPositions();

                const targetRect = targetLi.getBoundingClientRect();

                const middle =
                    targetRect.top + targetRect.height / 2;

                if (moveEvent.clientY < middle) {
                    if (placeholder.nextSibling !== targetLi) {
                        todoList.insertBefore(
                            placeholder,
                            targetLi
                        );
                    }
                } else {
                    if (targetLi.nextSibling !== placeholder) {
                        todoList.insertBefore(
                            placeholder,
                            targetLi.nextSibling
                        );
                    }
                }

                animateMovement(oldPositions);
            }

            function stop() {
                todoList.insertBefore(li, placeholder);

                placeholder.remove();

                li.classList.remove("dragging");

                li.style.position = "";
                li.style.width = "";
                li.style.height = "";

                li.style.left = "";
                li.style.top = "";

                li.style.zIndex = "";
                li.style.opacity = "";
                li.style.pointerEvents = "";
                li.style.transition = "";
                li.style.transform = "";

                const items = todoList.querySelectorAll("li");
                const newTodos = [];

                items.forEach(function(item) {
                    const text =
                        item.querySelector("span").textContent;

                    newTodos.push(text);
                });

                todos = newTodos;

                saveTodos();

                document.removeEventListener("mousemove", move);
                document.removeEventListener("mouseup", stop);

                animateMovement(finalPositions);
            }

            const finalPositions = getPositions();

            document.addEventListener("mousemove", move);
            document.addEventListener("mouseup", stop);
        });

        todoList.appendChild(li);
    });
}

function saveTodos() {
    localStorage.setItem("todos", JSON.stringify(todos));
}

function addTodo() {
    const todoText = input.value.trim();

    if (todoText === "") {
        return;
    }

    todos.push(todoText);

    saveTodos();

    displayTodos();

    input.value = "";

    input.focus();
}

addBtn.addEventListener("click", addTodo);

input.addEventListener("keydown", function(event) {
    if (event.key === "Enter") {
        addTodo();
    }
});

displayTodos();
