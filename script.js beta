const input = document.getElementById("todoInput");
// html에서 "todoinput"이라는 할 일을 입력하는 input 요소를 가져옴

const addBtn = document.getElementById("addBtn");
// html에서 "addBtn"이라는 추가 버튼 요소를 가져옴

const todoList = document.getElementById("todoList");
// html에서 "todolist"이라는 할 일 목록인 ul 요소를 가져옴


// todos라는 변수를 만들고 할 일들을 배열로 저장함 
// localStorage에 저장된 할 일을 가져옴
// 저장된 값이 없으면 빈 배열을 사용함
let todos = JSON.parse(localStorage.getItem("todos")) || [];

// 할 일 목록을 화면에 표시하는 함수
function displayTodos(){

    // 기존 목록을 모두 삭제합니다.
    todoList.innerHTML = "";


    // todos 배열의 할 일을 하나씩 화면에 표시
    todos.forEach(function(todo, index){

        // 새로운 li 요소를 만듭니다.
        const li = document.createElement("li");


        


        // 현재 할 일의 번호를 저장합니다.
        li.dataset.index = index;


        // 할 일 내용과 삭제 버튼을 넣습니다.
        li.innerHTML = `
            <span>${todo}</span>
            <button class="delete-btn">삭제</button>`;


        // 삭제 버튼을 가져옵니다.
        const deleteBtn = li.querySelector(".delete-btn");


        // 삭제 버튼을 클릭했을 때 실행됩니다.
        deleteBtn.addEventListener("click", function() {

            // 해당 할 일을 배열에서 삭제합니다.
            todos.splice(index, 1);


            // 변경된 배열을 localStorage에 저장합니다.
            saveTodos();


            // 화면을 다시 표시합니다.
            displayTodos();

        });


        

        


        li.addEventListener("mousedown", function(event){
            // 삭제 버튼을 누른 경우에는 드래그하지 않습니다.
            if (event.target.classList.contains("delete-btn")) {
                return;
            }

            const rect = li.getBoundingClientRect();

            const originalWidth = rect.width;
            const originalHeight = rect.height;

            // 마우스가 li의 어느 부분을 잡았는지 계산합니다.
            const offsetX = event.clientX - rect.left;
            const offsetY = event.clientY - rect.top;

            // li를 마우스를 따라가도록 이동합니다.
            li.style.position = "fixed";
            li.style.left = rect.left + "px";
            li.style.top = rect.top + "px";
            

            function move(event) {

                li.style.left = (event.clientX - offsetX) + "px";
                li.style.top = (event.clientY - offsetY) + "px";

                

                const target = document.elementFromPoint(
                    event.clientX,
                    event.clientY
                );

                const targetLi = target ? target.closest("li") : null;

                if(targetLi && targetLi !== li){
                    const targetRect = targetLi.getBoundingClientRect();

                    const targetMiddle = targetRect.top + targetRect.height / 2;

                    if(event.clientY < targetMiddle){
                        todoList.inserBefore(li, targetLi);
                    } else {
                        todolist.inserBefore(li, targetLi.nextSibling);
                    }
                }
            }
               
            
            function(stop){
                const items = todolist.querySelectorAll("li");
                
                const newTodos = [];

                items.forEach(function(item){
                    const text = item.querySeletor("span")
                });

            }
        
            
        // li를 목록에 추가합니다.
        todoList.appendChild(li);

        });
        });

    }
// localStorage에 할 일을 저장하는 함수
function saveTodos() {

    // 배열을 JSON 문자열로 변환해서 저장합니다.
    localStorage.setItem("todos", JSON.stringify(todos));

}



// 새로운 할 일을 추가하는 함수
function addTodo() {

    // 입력창의 내용을 가져옵니다.
    const todoText = input.value.trim();


    // 빈 내용을 입력하면 추가하지 않습니다.
    if (todoText === "") {
        return;
    }


    // 새로운 할 일을 배열에 추가합니다.
    todos.push(todoText);


    // localStorage에 저장합니다.
    saveTodos();


    // 화면을 다시 표시합니다.
    displayTodos();


    // 입력창을 비웁니다.
    input.value = "";


    // 입력창에 다시 커서를 놓습니다.
    input.focus();

}



// 추가 버튼을 클릭하면 할 일을 추가합니다.
addBtn.addEventListener("click", addTodo);



// Enter 키를 누르면 할 일을 추가합니다.
input.addEventListener("keydown", function(event) {

    // Enter 키인지 확인합니다.
    if (event.key === "Enter") {

        // 할 일을 추가합니다.
        addTodo();

    }

});



// 페이지가 처음 실행될 때
// 저장된 할 일을 화면에 표시합니다.
displayTodos();
