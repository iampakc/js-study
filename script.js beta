const input = document.getElementById("todoInput");
// 할 일을 입력하는 input 요소를 가져옵니다.

const addBtn = document.getElementById("addBtn");
// 추가 버튼을 가져옵니다.

const todoList = document.getElementById("todoList");
// 할 일 목록인 ul 요소를 가져옵니다.


// localStorage에 저장된 할 일을 가져옵니다.
// 저장된 값이 없으면 빈 배열을 사용합니다.
let todos = JSON.parse(localStorage.getItem("todos")) || [];


// 할 일 목록을 화면에 표시하는 함수
function displayTodos() {

    // 기존 목록을 모두 삭제합니다.
    todoList.innerHTML = "";


    // todos 배열의 할 일을 하나씩 화면에 표시합니다.
    todos.forEach(function(todo, index) {

        // 새로운 li 요소를 만듭니다.
        const li = document.createElement("li");




        // 현재 할 일의 번호를 저장합니다.
        li.dataset.index = index;


        // 할 일 내용과 삭제 버튼을 넣습니다.
        li.innerHTML = `
            <span>${todo}</span>
            <button class="delete-btn">삭제</button>
        `;


        // 삭제 버튼을 가져옵니다.
        const deleteBtn = li.querySelector(".delete-btn");


        // 삭제 버튼을 클릭했을 때 실행됩니다.
        deleteBtn.addEventListener("click", function() {

            // 해당 할 일을 배열에서 삭제합니다.
            todos.splice(index, 1);


            // 변경된 배열을 localStorage에 저장합니다.
            saveTodos();


            // 화면을 다시 표시합니다.
            displayTodos();

        });
        li.addEventListener("mousedown", function(event) {

            // 삭제 버튼을 클릭한 경우에는 드래그하지 않습니다.
            if (event.target.classList.contains("delete-btn")) {
                return;
        }

            // 현재 li의 위치를 가져옵니다.
            let currentX = li.getBoundingClientRect().left;
            let currentY = li.getBoundingClientRect().top;

            // 마우스가 목표로 이동해야 하는 위치
            let targetX = currentX;
            let targetY = currentY;

            // 애니메이션 번호를 저장합니다.
            let animationFrame;

            // 마우스가 li의 어느 위치를 잡았는지 계산합니다.
            const offsetX = event.clientX - currentX;
            const offsetY = event.clientY - currentY;

            // 원래 CSS 위치를 저장합니다.
            const originalPosition = li.style.position;
            const originalLeft = li.style.left;
            const originalTop = li.style.top;

            // 드래그하기 전 li의 실제 크기를 저장합니다.
            const rect = li.getBoundingClientRect();

            li.style.width = rect.width + "px";
            li.style.height = rect.height + "px";
            // li를 실제로 움직이기 위해 fixed로 설정합니다.
            li.style.position = "fixed";
            li.style.left = currentX + "px";
            li.style.top = currentY + "px";

            // 마우스를 움직일 때 실행됩니다.
            function move(event) {

                targetX = event.clientX - offsetX;
                targetY = event.clientY - offsetY;

                // 부드럽게 이동하는 함수
                function animate() {

                    currentX += (targetX - currentX) * 0.2;
                    currentY += (targetY - currentY) * 0.2;

                    li.style.left = currentX + "px";
                    li.style.top = currentY + "px";

            animationFrame = requestAnimationFrame(animate);
        }

        cancelAnimationFrame(animationFrame);
        animationFrame = requestAnimationFrame(animate);
    }

    // 마우스를 놓았을 때 실행됩니다.
    function stop() {

        cancelAnimationFrame(animationFrame);

        // 원래 자리로 돌아갑니다.
        li.style.position = originalPosition;
        li.style.left = originalLeft;
        li.style.top = originalTop;

        li.style.width = "";
        li.style.height = "";

        // 이벤트를 제거합니다.
        document.removeEventListener("mousemove", move);
        document.removeEventListener("mouseup", stop);
    }

    // 마우스를 움직이면 li가 따라갑니다.
    document.addEventListener("mousemove", move);

    // 마우스를 놓으면 원래 자리로 돌아갑니다.
    document.addEventListener("mouseup", stop);
});
       


        // li를 목록에 추가합니다.
        todoList.appendChild(li);

    });
}



// localStorage에 할 일을 저장하는 함수
function saveTodos() {

    // 배열을 JSON 문자열로 변환해서 저장합니다.
    localStorage.setItem("todos", JSON.stringify(todos));

}



// 새로운 할 일을 추가하는 함수
function addTodo() {

    // 입력창의 내용을 가져옵니다.
    const todoText = input.value.trim();


    // 빈 내용을 입력하면 추가하지 않습니다.
    if (todoText === "") {
        return;
    }


    // 새로운 할 일을 배열에 추가합니다.
    todos.push(todoText);


    // localStorage에 저장합니다.
    saveTodos();


    // 화면을 다시 표시합니다.
    displayTodos();


    // 입력창을 비웁니다.
    input.value = "";


    // 입력창에 다시 커서를 놓습니다.
    input.focus();

}



// 추가 버튼을 클릭하면 할 일을 추가합니다.
addBtn.addEventListener("click", addTodo);



// Enter 키를 누르면 할 일을 추가합니다.
input.addEventListener("keydown", function(event) {

    // Enter 키인지 확인합니다.
    if (event.key === "Enter") {

        // 할 일을 추가합니다.
        addTodo();

    }

});



// 페이지가 처음 실행될 때
// 저장된 할 일을 화면에 표시합니다.
displayTodos();
