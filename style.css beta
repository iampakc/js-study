/* 페이지 전체 설정 */
body{

    font-family: Arial, sans-serif;
    /* 글꼴 */

    background-color:#f2f2f2;
    /* 배경색 */

    display:flex;
    /* 가운데 정렬을 쉽게 하기 위해 Flex 사용 */

    justify-content:center;
    /* 가로 가운데 */

    align-items:center;
    /* 세로 가운데 */

    height:100vh;
    /* 화면 전체 높이 */
}


/* 흰색 박스 */
.container{

    background:rgb(255, 255, 255);
    /* 배경 */

    width:350px;
    /* 가로 크기 */

    padding:30px;
    /* 안쪽 여백 */

    border-radius:15px;
    /* 모서리를 둥글게 */

    box-shadow:0 0 10px gray;
    /* 그림자 */
}


/* 제목 */
h1{

    text-align:center;
    /* 가운데 정렬 */

}


/* 입력창과 버튼 */
.input-area{

    display:flex;
    /* 가로 배치 */

    gap:10px;
    /* 입력창과 버튼 사이 간격 */

}


/* 입력창 */
input{

    flex:1;
    /* 남은 공간을 모두 사용 */

    padding:10px;
    /* 안쪽 여백 */

    font-size:16px;
    /* 글자 크기 */

}


/* 모든 버튼 */
button{

    padding:10px 15px;

    border:none;

    background:#4CAF50;

    color:white;

    cursor:pointer;

    border-radius:5px;

}


/* 버튼에 마우스를 올렸을 때 */
button:hover{

    opacity:0.8;

}


/* 목록 */
ul{

    list-style:none;
    /* ● 제거 */

    padding:0;

    margin-top:20px;

}


/* 각각의 할 일 */
li{

    display:flex;
    /* 글자와 버튼을 양쪽 배치 */

    justify-content:space-between;

    align-items:center;

    background:#eee;

    padding:10px;

    margin-bottom:10px;

    border-radius:5px;

}


/* 삭제 버튼 */
.delete-btn{

    background:red;

    padding:5px 10px;

}

li {
    cursor: grab;
    transition: left 0.15s ease, top 0.15s ease;
}

li:active {
    cursor: grabbing;
}
